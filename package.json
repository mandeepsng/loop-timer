{
  "name": "looptimer",
  "version": "1.0.1",
  "description": "Loop reminder",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "electron-builder",
    "dev": "electron .",
    "start": "electron-forge start",
    "build": "electron-builder",
    "build:win": "electron-builder build --win --publish never",
    "build:linux": "electron-builder build --linux --publish never"
  },
  "author": {
    "name": "Mandeep Singh",
    "email": "mandeep@rvsmedia.com"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^24.1.2",
    "electron-builder": "^23.6.0",
    "electron-packager": "^17.1.1",
    "node-addon-api": "^7.0.0"
  },
  "dependencies": {
    "accelerator": "^0.2.0",
    "active-win": "^8.1.0",
    "axios": "^1.4.0",
    "buffer": "^6.0.3",
    "fs-extra": "^11.1.1",
    "lodash": "^4.17.21",
    "openai": "^3.3.0",
    "pyodide": "^0.23.4",
    "stream": "^0.0.2"
  },
  "build": {
    "appId": "com.looptimer.app",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "your.app.category",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
